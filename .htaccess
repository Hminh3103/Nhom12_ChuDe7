Options -Indexes
RewriteEngine On
# Open the public entry point when browsing the project folder in XAMPP.
RewriteCond %{REQUEST_URI} /$
RewriteRule ^$ %{REQUEST_URI}public/ [R=302,L]
RewriteRule ^(?:app|config|data|storage|tests)(?:/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:README\.md|KeHoach_.*\.md)$ - [F,L]
